# Required — the only network dependency at query time.
OPENAI_API_KEY=sk-...

# Required only to build the data: scripts/fetch_github_issues.py.
# A plain read-only personal access token is enough; without one the
# GitHub API rate-limits the ingestion run to 60 requests an hour.
GITHUB_TOKEN=ghp_...

# Optional — tracing. Leave LANGSMITH_TRACING unset to keep it off.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=aws-ai-agent
